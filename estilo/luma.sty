% Estilo del manual LUMA. Compilar con Tectonic (XeTeX).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{estilo/luma}[2026/11/15 Manual LUMA]

% ---------- Idioma y tipografía ----------
\RequirePackage{fontspec}
\RequirePackage[spanish,es-noshorthands,es-tabla,es-nodecimaldot]{babel}
\setmainfont{texgyrepagella}[Extension=.otf, UprightFont=*-regular, BoldFont=*-bold, ItalicFont=*-italic, BoldItalicFont=*-bolditalic]
\setsansfont{texgyreheros}[Extension=.otf, UprightFont=*-regular, BoldFont=*-bold, ItalicFont=*-italic, BoldItalicFont=*-bolditalic]
\setmonofont{lmmono10-regular}[Extension=.otf, Scale=0.95]
\RequirePackage{microtype}

% ---------- Página ----------
\RequirePackage[a4paper, top=25mm, bottom=25mm, left=25mm, right=22mm, headheight=14pt]{geometry}
\RequirePackage{xcolor}
\definecolor{grafito}{HTML}{191C1F}
\definecolor{grafitoclaro}{HTML}{2A2E33}
\definecolor{lima}{HTML}{D9FC85}
\definecolor{acento}{HTML}{4F7300}
\definecolor{marfil}{HTML}{F4F1E8}
\definecolor{rojoaviso}{HTML}{B3261E}
\definecolor{azulnota}{HTML}{1F5FA8}
\definecolor{naranjapend}{HTML}{C25E00}

\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\sffamily\small\color{grafitoclaro}LUMA · Manual técnico}
\fancyhead[R]{\sffamily\small\color{grafitoclaro}\nouppercase{\leftmark}}
\fancyfoot[C]{\sffamily\small\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\sffamily\small\thepage}\renewcommand{\headrulewidth}{0pt}}

\RequirePackage{titlesec}
\titleformat{\part}[display]{\centering\sffamily\bfseries\Huge\color{grafito}}{\large\color{acento}PARTE \thepart}{12pt}{}
\titleformat{\chapter}[display]{\sffamily\bfseries\huge\color{grafito}}{\large\color{acento}Capítulo \thechapter}{6pt}{}[\vspace{2pt}{\color{acento}\titlerule[1.2pt]}]
\titlespacing*{\chapter}{0pt}{0pt}{18pt}
\titleformat{\section}{\sffamily\bfseries\Large\color{grafito}}{\color{acento}\thesection}{0.6em}{}
\titleformat{\subsection}{\sffamily\bfseries\large\color{grafito}}{\color{acento}\thesubsection}{0.6em}{}

\setlength{\parindent}{0pt}
\setlength{\parskip}{0.55em}

% ---------- Tablas, figuras, listas ----------
\RequirePackage{graphicx}
\RequirePackage{booktabs}
\RequirePackage{longtable}
\RequirePackage{tabularx}
\RequirePackage{array}
\RequirePackage{float}
\RequirePackage{caption}
\captionsetup{font={small,sf}, labelfont=bf}
\RequirePackage{enumitem}
\setlist{itemsep=0.25em, topsep=0.4em}
\RequirePackage{amssymb}

% ---------- Diagramas ----------
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta, positioning, fit, shapes.geometric, calc, backgrounds, babel}

% ---------- Código y comandos ----------
\RequirePackage{listings}
\lstdefinestyle{luma}{basicstyle=\ttfamily\small, columns=fullflexible, keepspaces=true, breaklines=true,
  backgroundcolor=\color{marfil}, frame=single, rulecolor=\color{grafitoclaro!30}, framesep=6pt, xleftmargin=8pt, xrightmargin=8pt,
  showstringspaces=false, upquote=true, extendedchars=true, inputencoding=utf8,
  literate={á}{{\'a}}1 {é}{{\'e}}1 {í}{{\'i}}1 {ó}{{\'o}}1 {ú}{{\'u}}1 {ñ}{{\~n}}1 {Á}{{\'A}}1 {É}{{\'E}}1 {Í}{{\'I}}1 {Ó}{{\'O}}1 {Ú}{{\'U}}1 {Ñ}{{\~N}}1 {¿}{{?`}}1 {¡}{{!`}}1 {·}{{$\cdot$}}1 {›}{{>}}1}
\lstset{style=luma}
\lstnewenvironment{comando}{\lstset{style=luma}}{}
\lstnewenvironment{codigo}[1][]{\lstset{style=luma, #1}}{}
\newcommand{\cmd}[1]{\texttt{\detokenize{#1}}}

% ---------- Enlaces ----------
\RequirePackage[hidelinks, pdfusetitle]{hyperref}
\RequirePackage{xurl}

% ---------- Recuadros ----------
\RequirePackage[most]{tcolorbox}
\tcbset{lumabase/.style={enhanced, breakable, boxrule=0pt, leftrule=4pt, arc=2pt, left=8pt, right=8pt, top=6pt, bottom=6pt, fonttitle=\sffamily\bfseries\small, coltitle=white}}
\newtcolorbox{cajaadvertencia}{lumabase, colback=rojoaviso!6, colframe=rojoaviso, detach title, before upper={\textcolor{rojoaviso}{\sffamily\bfseries ADVERTENCIA}\quad}}
\newtcolorbox{cajanota}{lumabase, colback=azulnota!6, colframe=azulnota, detach title, before upper={\textcolor{azulnota}{\sffamily\bfseries NOTA}\quad}}
\newtcolorbox{cajapendiente}[1]{lumabase, colback=naranjapend!8, colframe=naranjapend, detach title, before upper={\textcolor{naranjapend}{\sffamily\bfseries PENDIENTE}\enspace{\scriptsize\ttfamily\color{naranjapend}[#1]}\quad}}
\newcommand{\advertencia}[1]{\begin{cajaadvertencia}#1\end{cajaadvertencia}}
\newcommand{\nota}[1]{\begin{cajanota}#1\end{cajanota}}
% \pendiente{clave}{texto}: dato que el equipo todavía debe confirmar. Las claves permitidas están en tests/pendientes.test.mjs.
\newcommand{\pendiente}[2]{\begin{cajapendiente}{#1}#2\end{cajapendiente}}

% ---------- Datos del poste ----------
% build/datos.tex (de datos/poste.json) define cada dato con \setdato{clave}{valor}.
\newcommand{\PENDIENTE}{\textcolor{naranjapend}{\sffamily\bfseries PENDIENTE}}
\newcommand{\setdato}[2]{\expandafter\def\csname dato@#1\endcsname{#2}}
\newcommand{\dato}[1]{\ifcsname dato@#1\endcsname\csname dato@#1\endcsname\else\PackageError{luma}{Dato '#1' no existe en datos/poste.json}{Añádelo a datos/poste.json y ejecuta npm run datos.}\fi}

% ---------- Imágenes ----------
% \foto{id}{qué fotografiar}{ancho relativo}: usa img/fotos/<id>.jpg; si aún no existe, deja un marco con la descripción.
\newcommand{\foto}[3]{%
  \begin{figure}[H]\centering
  \IfFileExists{img/fotos/#1.jpg}{\includegraphics[width=#3\linewidth]{img/fotos/#1.jpg}}{%
    \fcolorbox{grafitoclaro!40}{grafitoclaro!5}{\parbox[c][0.25\textheight][c]{#3\linewidth}{\centering\sffamily
      {\color{naranjapend}\bfseries FOTO PENDIENTE}\\[4pt]{\small #2}\\[4pt]{\scriptsize\ttfamily img/fotos/#1.jpg}}}}%
  \caption{#2}\label{foto:#1}\end{figure}}
% \captura{nombre}{pie}: captura de LUMA en img/app/<nombre>.png
\newcommand{\captura}[3][0.42]{%
  \begin{figure}[H]\centering\includegraphics[height=#1\textheight, width=\linewidth, keepaspectratio]{img/app/#2.png}\caption{#3}\label{captura:#2}\end{figure}}
